# Copy to .env.dev / .env.staging / .env.prod and pass one at build time:
#   flutter run --dart-define-from-file=.env.dev
# Values are compiled into the app binary — never put secrets here.

# false (the default) = talk to API_BASE_URL. true = demo data from seed
# JSON, kept in memory and reset on restart (the app shows a DEMO ribbon).
USE_MOCKS=false

# Laravel host, without /v1 (default https://petalsinajar.com). Use https
# outside local dev: release builds block cleartext http on Android and iOS.
API_BASE_URL=https://petalsinajar.com

# dev | staging | prod
FLAVOR=dev
