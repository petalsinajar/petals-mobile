# Copy to .env.dev / .env.staging / .env.prod and pass one at build time:
#   flutter run --dart-define-from-file=.env.dev
# Values are compiled into the app binary — never put secrets here.

# true = seed JSON, no network. false = talk to API_BASE_URL.
USE_MOCKS=true

# Laravel host, without /v1. Use https outside local dev: release builds
# block cleartext http on both Android and iOS.
API_BASE_URL=

# dev | staging | prod
FLAVOR=dev
