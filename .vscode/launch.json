{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Mock",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": ["--dart-define=USE_MOCKS=true"]
    },
    {
      "name": "Dev (.env.dev)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": ["--dart-define-from-file=.env.dev"]
    },
    {
      "name": "Production API (.env.prod)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": ["--dart-define-from-file=.env.prod"]
    }
  ]
}
